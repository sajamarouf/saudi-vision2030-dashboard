	partition DimQuarter = m
		mode: import
		source =
				let
				    Source = let Keys = List.Distinct(FactKPI[QuarterKey]), ToAbs = (k as text) as number => Number.From(Text.Start(k, 4)) * 4 + Number.From(Text.End(k, 1)) - 1, AbsList = List.Transform(Keys, ToAbs), MinAbs = List.Min(AbsList), MaxAbs = List.Max(AbsList), Base = Table.FromList({MinAbs .. MaxAbs}, Splitter.SplitByNothing(), {"Abs"}), AddYear = Table.AddColumn(Base, "Year", each Number.IntegerDivide([Abs], 4), Int64.Type), AddQNum = Table.AddColumn(AddYear, "QuarterNum", each Number.Mod([Abs], 4) + 1, Int64.Type), AddKey = Table.AddColumn(AddQNum, "QuarterKey", each Text.From([Year]) & "Q" & Text.From([QuarterNum]), type text), AddLabel = Table.AddColumn(AddKey, "QuarterLabel", each "Q" & Text.From([QuarterNum]) & " " & Text.From([Year]), type text), AddStart = Table.AddColumn(AddLabel, "QuarterStart", each #date([Year], ([QuarterNum] - 1) * 3 + 1, 1), type date), AddIndex = Table.AddColumn(AddStart, "QuarterIndex", each [Abs] - MinAbs + 1, Int64.Type), AddPeriod = Table.AddColumn(AddIndex, "Period", each if [Year] <= 2019 then "Pre-COVID (2017-19)" else if [Year] <= 2021 then "COVID & recovery (2020-21)" else if [Year] <= 2024 then "Acceleration (2022-24)" else "Late Vision (2025+)", type text), AddCovid = Table.AddColumn(AddPeriod, "IsCovidShock", each List.Contains({"2020Q2", "2020Q3"}, [QuarterKey]), type logical), Result = Table.SelectColumns(AddCovid, {"QuarterKey", "Year", "QuarterNum", "QuarterLabel", "QuarterStart", "QuarterIndex", "Period", "IsCovidShock"}) in Result
				in
				    Source

