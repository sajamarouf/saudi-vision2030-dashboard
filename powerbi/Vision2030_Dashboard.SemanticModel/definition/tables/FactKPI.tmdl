table FactKPI
	lineageTag: 890d72b7-8c3f-419c-acc8-cdc4a1344f40

	measure 'KPI Value' = ```
			
					IF ( HASONEVALUE ( DimIndicator[IndicatorKey] ), AVERAGE ( FactKPI[Value] ) )
			```
		formatString: 0.0\%
		lineageTag: 5a685703-3cfd-4c3a-ab31-2b33b63e137b

	measure 'Latest Quarter Index' = ```
			
					CALCULATE ( MAXX ( FactKPI, RELATED ( DimQuarter[QuarterIndex] ) ), ALL ( DimQuarter ) )
			```
		formatString: 0
		lineageTag: 70161746-348f-4b0e-8891-ff9d07bd5f7d

	measure 'Latest Value' = ```
			
					VAR _idx = [Latest Quarter Index]
					RETURN CALCULATE ( [KPI Value], ALL ( DimQuarter ), DimQuarter[QuarterIndex] = _idx )
			```
		formatString: 0.0\%
		lineageTag: c6acb869-229f-4bc8-b9e6-76d469a86616

	measure 'Latest Quarter Label' = ```
			
					VAR _idx = [Latest Quarter Index]
					RETURN CALCULATE ( SELECTEDVALUE ( DimQuarter[QuarterLabel] ), ALL ( DimQuarter ), DimQuarter[QuarterIndex] = _idx )
			```
		lineageTag: cf0d45af-0d02-4609-b438-48f1b29eaa94

	measure 'Value Prev Quarter' = ```
			
					VAR _idx = MAX ( DimQuarter[QuarterIndex] )
					RETURN CALCULATE ( [KPI Value], ALL ( DimQuarter ), DimQuarter[QuarterIndex] = _idx - 1 )
			```
		formatString: 0.0\%
		lineageTag: 8cbcb2f5-6833-4e5e-9f9a-2f27b4385c61

	measure 'Value Same Quarter LY' = ```
			
					VAR _idx = MAX ( DimQuarter[QuarterIndex] )
					RETURN CALCULATE ( [KPI Value], ALL ( DimQuarter ), DimQuarter[QuarterIndex] = _idx - 4 )
			```
		formatString: 0.0\%
		lineageTag: 56b3a678-b137-4fd4-b819-acd48d385a49

	measure 'QoQ Change pp' = ```
			
					IF ( NOT ISBLANK ( [Value Prev Quarter] ), [KPI Value] - [Value Prev Quarter] )
			```
		formatString: +0.0 \p\p;-0.0 \p\p;0.0 \p\p
		lineageTag: 3c2ac270-236a-4db8-be5d-57add5aa7bd8

	measure 'YoY Change pp' = ```
			
					IF ( NOT ISBLANK ( [Value Same Quarter LY] ), [KPI Value] - [Value Same Quarter LY] )
			```
		formatString: +0.0 \p\p;-0.0 \p\p;0.0 \p\p
		lineageTag: 62b415cf-0616-4f2b-bccf-11791ad04ad7

	measure 'Rolling 4Q Avg' = ```
			
					VAR _idx = MAX ( DimQuarter[QuarterIndex] )
					VAR _win = CALCULATETABLE ( VALUES ( DimQuarter[QuarterIndex] ), ALL ( DimQuarter ), DimQuarter[QuarterIndex] > _idx - 4, DimQuarter[QuarterIndex] <= _idx )
					VAR _n = CALCULATE ( COUNTROWS ( FactKPI ), ALL ( DimQuarter ), DimQuarter[QuarterIndex] IN _win )
					RETURN IF ( _n = 4, CALCULATE ( AVERAGE ( FactKPI[Value] ), ALL ( DimQuarter ), DimQuarter[QuarterIndex] IN _win ) )
			```
		formatString: 0.0\%
		lineageTag: 98349c87-7747-4888-bacc-e978ea36ec94

	measure 'Latest YoY pp' = ```
			
					VAR _idx = [Latest Quarter Index]
					VAR _ly = CALCULATE ( [KPI Value], ALL ( DimQuarter ), DimQuarter[QuarterIndex] = _idx - 4 )
					RETURN IF ( NOT ISBLANK ( _ly ), [Latest Value] - _ly )
			```
		formatString: +0.0 \p\p;-0.0 \p\p;0.0 \p\p
		lineageTag: daef950e-1c14-45d7-a575-b054f887f017

	measure 'YoY Arrow' = ```
			
					VAR _d = [Latest YoY pp]
					RETURN SWITCH ( TRUE (), ISBLANK ( _d ), "", _d = 0, "▬ 0.0 pp YoY", _d > 0, "▲ +" & FORMAT ( _d, "0.0" ) & " pp YoY", "▼ " & FORMAT ( _d, "0.0" ) & " pp YoY" )
			```
		lineageTag: 404ed93e-6c44-4873-aecc-09b269f51723

	measure 'YoY Color' = ```
			
					VAR _d = [Latest YoY pp]
					VAR _better = SELECTEDVALUE ( DimIndicator[BetterWhen] )
					RETURN SWITCH ( TRUE (), ISBLANK ( _d ) || _d = 0, "#6B7280", ( _d < 0 && _better = "lower" ) || ( _d > 0 && _better = "higher" ), "#0E7C4A", "#B42318" )
			```
		lineageTag: 7b498fdc-a905-4983-9d38-0585c884c1da

	measure 'Target 2030 Original' = MAX ( DimTarget[OriginalTarget2030] )
		formatString: 0.0\%
		lineageTag: a5da126d-bb2c-49d5-b891-22c166d0ccd3

	measure 'Target 2030 Revised' = MAX ( DimTarget[RevisedTarget2030] )
		formatString: 0.0\%
		lineageTag: b63101ac-1521-4567-85b8-eae8bf365924

	measure 'Baseline Value' = MAX ( DimTarget[BaselineValue] )
		formatString: 0.0\%
		lineageTag: 150125cb-c014-4fa2-abe0-4d836befb112

	measure 'Gap to Revised Target pp' = [Latest Value] - [Target 2030 Revised]
		formatString: +0.0 \p\p;-0.0 \p\p;0.0 \p\p
		lineageTag: f0b888c4-b71b-4911-9127-a3bbeec678be

	measure 'Progress to Revised Target %' = ```
			
					VAR _b = [Baseline Value]
					VAR _t = [Target 2030 Revised]
					RETURN IF ( NOT ISBLANK ( _t ), DIVIDE ( [Latest Value] - _b, _t - _b ) )
			```
		formatString: 0%
		lineageTag: a98b954a-a7d4-4197-ac4e-c8ef8b8eeecf

	measure 'Target Status' = ```
			
					VAR _p = [Progress to Revised Target %]
					VAR _b = [Baseline Value]
					VAR _orig = DIVIDE ( [Latest Value] - _b, [Target 2030 Original] - _b )
					RETURN SWITCH ( TRUE (), ISBLANK ( _p ), BLANK (), _p >= 1, "Revised target met", _orig >= 1, "Original met · revised pending", "Below original target" )
			```
		lineageTag: 322279b6-2774-4d19-b2f1-fbcb27ebe713

