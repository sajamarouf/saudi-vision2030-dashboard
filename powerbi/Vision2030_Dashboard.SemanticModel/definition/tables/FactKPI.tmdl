	partition FactKPI = m
		mode: import
		source =
				let
				    Source = let Source = Vision2030DB{[Schema="dw",Item="vw_FactKPI"]}[Data], Typed = Table.TransformColumnTypes(Source, {{"QuarterKey", type text}, {"IndicatorKey", type text}, {"Value", type number}, {"SeriesVintage", type text}, {"EstimateType", type text}, {"SourceID", type text}, {"Note", type text}}), AddIsFlash = Table.AddColumn(Typed, "IsFlash", each [EstimateType] <> "final", type logical), AddIsPreRevision = Table.AddColumn(AddIsFlash, "IsPreRevision", each [SeriesVintage] = "pre_census2022", type logical) in AddIsPreRevision
